<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="680.0" prefWidth="1000.0" styleClass="root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parqueadero.controller.AdministradorController"
            stylesheets="@../css/parkuq.css">

    <!-- ===== ENCABEZADO ===== -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <VBox spacing="2">
                <Label text="PARKUQ" styleClass="header-title"/>
                <Label text="Panel Administrador — Espacios, tarifas y usuarios" styleClass="header-sub"/>
            </VBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="Universidad del Quindio" styleClass="header-sub"/>
            <Button onAction="#onCerrarSesion" text="Cerrar sesion" styleClass="btn-white"/>
        </HBox>
    </top>

    <!-- ===== CONTENIDO CENTRAL EN PESTANAS ===== -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- PESTANA 1: ESPACIOS -->
            <Tab text="Espacios">
                <content>
                    <HBox spacing="20" style="-fx-padding: 16;">

                        <!-- Formulario izquierdo -->
                        <VBox spacing="12" styleClass="card" prefWidth="340">
                            <Label text="Gestion de espacios" styleClass="card-title"/>
                            <Label text="Registrar, modificar o deshabilitar espacios"
                                   styleClass="card-subtitle" wrapText="true"/>

                            <GridPane hgap="12" vgap="10">
                                <Label text="Codigo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="txtCodigoEspacio" promptText="Ej: C04"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="190"/>

                                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <ComboBox fx:id="cmbTipoEspacio"
                                          GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="190"/>

                                <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <ComboBox fx:id="cmbEstadoEspacio"
                                          GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="190"/>
                            </GridPane>

                            <Button onAction="#onAgregarEspacio" text="Nuevo espacio"
                                    styleClass="btn-primary" maxWidth="Infinity"/>
                            <Button onAction="#onCargarEspacioSeleccionado" text="Cargar seleccionado"
                                    styleClass="btn-secondary" maxWidth="Infinity"/>
                            <Button onAction="#onModificarEspacio" text="Modificar espacio"
                                    styleClass="btn-warning" maxWidth="Infinity"/>
                            <Button onAction="#onDeshabilitarEspacio" text="Deshabilitar espacio"
                                    styleClass="btn-danger" maxWidth="Infinity"/>

                            <Label wrapText="true" styleClass="card-subtitle"
                                   text="Para modificar: seleccione de la lista, presione 'Cargar', cambie los datos y presione 'Modificar'."/>
                        </VBox>

                        <!-- Lista derecha -->
                        <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Espacios registrados" styleClass="card-title"/>
                            <ListView fx:id="listaEspacios" VBox.vgrow="ALWAYS"/>
                        </VBox>

                    </HBox>
                </content>
            </Tab>

            <!-- PESTANA 2: TARIFAS -->
            <Tab text="Tarifas">
                <content>
                    <HBox spacing="20" style="-fx-padding: 16;">

                        <!-- Formulario izquierdo -->
                        <VBox spacing="12" styleClass="card" prefWidth="320">
                            <Label text="Tarifas por hora" styleClass="card-title"/>
                            <Label text="Configure el valor por hora y descuento para usuarios autorizados"
                                   styleClass="card-subtitle" wrapText="true"/>

                            <GridPane hgap="12" vgap="10">
                                <Label text="Tipo vehiculo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <ComboBox fx:id="cmbTipoTarifa"
                                          GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="170"/>

                                <Label text="Valor por hora:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="txtValorHora" promptText="Ej: 3000"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="170"/>

                                <Label text="Descuento %:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="txtDescuento" promptText="Ej: 10"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="170"/>
                            </GridPane>

                            <Button onAction="#onAgregarTarifa" text="Agregar tarifa"
                                    styleClass="btn-primary" maxWidth="Infinity"/>
                            <Button onAction="#onActualizarTarifa" text="Actualizar tarifa"
                                    styleClass="btn-secondary" maxWidth="Infinity"/>

                            <Label wrapText="true" styleClass="card-subtitle"
                                   text="El descuento aplica solo cuando el conductor esta registrado como usuario autorizado del parqueadero."/>
                        </VBox>

                        <!-- Lista derecha -->
                        <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Tarifas configuradas" styleClass="card-title"/>
                            <ListView fx:id="listaTarifas" VBox.vgrow="ALWAYS"/>
                        </VBox>

                    </HBox>
                </content>
            </Tab>

            <!-- PESTANA 3: USUARIOS AUTORIZADOS -->
            <Tab text="Usuarios autorizados">
                <content>
                    <HBox spacing="20" style="-fx-padding: 16;">

                        <!-- Formulario izquierdo -->
                        <VBox spacing="12" styleClass="card" prefWidth="360">
                            <Label text="Usuarios autorizados" styleClass="card-title"/>
                            <Label text="Estudiantes, docentes y visitantes con descuento"
                                   styleClass="card-subtitle" wrapText="true"/>

                            <GridPane hgap="12" vgap="8">
                                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="txtNombreUsuario" promptText="Nombre completo"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="190"/>

                                <Label text="Identificacion:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="txtIdUsuario" promptText="Numero de documento"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="190"/>

                                <Label text="Telefono:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="txtTelefonoUsuario" promptText="Ej: 3100000000"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="190"/>

                                <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <TextField fx:id="txtCorreoUsuario" promptText="correo@uq.edu.co"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="190"/>

                                <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                                <ComboBox fx:id="cmbTipoUsuario"
                                          GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="190"/>
                            </GridPane>

                            <Button onAction="#onAgregarUsuario" text="Registrar usuario"
                                    styleClass="btn-success" maxWidth="Infinity"/>
                            <Button onAction="#onCargarUsuarioSeleccionado" text="Cargar seleccionado"
                                    styleClass="btn-secondary" maxWidth="Infinity"/>
                            <Button onAction="#onActualizarUsuario" text="Actualizar usuario"
                                    styleClass="btn-warning" maxWidth="Infinity"/>
                            <Button onAction="#onEliminarUsuario" text="Eliminar usuario"
                                    styleClass="btn-danger" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Lista derecha -->
                        <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Usuarios registrados" styleClass="card-title"/>
                            <ListView fx:id="listaUsuarios" VBox.vgrow="ALWAYS"/>
                        </VBox>

                    </HBox>
                </content>
            </Tab>

        </TabPane>
    </center>

    <!-- ===== BARRA DE MENSAJES INFERIOR ===== -->
    <bottom>
        <Label fx:id="lblMensajeAdmin" wrapText="true" styleClass="mensaje-bar" maxWidth="Infinity"/>
    </bottom>

</BorderPane>
