<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="680.0" prefWidth="1000.0" styleClass="root"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.parqueadero.controller.OperadorController"
            stylesheets="@../css/parkuq.css">

    <!-- ===== ENCABEZADO ===== -->
    <top>
        <HBox styleClass="header-bar-operador" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <VBox spacing="2">
                <Label text="PARKUQ" styleClass="header-title"/>
                <Label text="Modulo Operador — Entradas, salidas y consultas" styleClass="header-sub"/>
            </VBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="Universidad del Quindio" styleClass="header-sub"/>
            <Button onAction="#onCerrarSesion" text="Cerrar sesion" styleClass="btn-white"/>
        </HBox>
    </top>

    <!-- ===== CONTENIDO CENTRAL EN PESTANAS ===== -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 12;">

            <!-- PESTANA 1: INGRESO -->
            <Tab text="Ingreso de vehiculo">
                <content>
                    <HBox spacing="20" style="-fx-padding: 16;">
                        <VBox spacing="14" styleClass="card" prefWidth="400">
                            <Label text="Registrar entrada" styleClass="card-title"/>
                            <Label text="Complete los datos del conductor y tipo de vehiculo"
                                   styleClass="card-subtitle" wrapText="true"/>

                            <GridPane hgap="12" vgap="12">
                                <Label text="Placa *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <TextField fx:id="txtPlacaIngreso" promptText="Ej: ABC123"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="220"/>

                                <Label text="Conductor *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <TextField fx:id="txtNombreConductor" promptText="Nombre completo"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="220"/>

                                <Label text="Identificacion *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <TextField fx:id="txtIdConductor" promptText="Numero de documento"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="220"/>

                                <Label text="Tipo vehiculo *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                <ComboBox fx:id="cmbTipoVehiculo"
                                          GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="220"/>
                            </GridPane>

                            <Button onAction="#onRegistrarIngreso" text="Registrar ingreso"
                                    styleClass="btn-success" maxWidth="Infinity"/>

                            <Label wrapText="true" styleClass="card-subtitle"
                                   text="El sistema asigna el espacio automaticamente segun el tipo de vehiculo.&#10;Si el conductor esta registrado como usuario autorizado se aplica descuento."/>
                        </VBox>

                        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Informacion del modulo" styleClass="card-title"/>
                            <Label wrapText="true" styleClass="card-subtitle"
                                   text="• Se valida que no haya espacios duplicados.&#10;• Se valida que la placa no este ya dentro del parqueadero.&#10;• Si no hay espacios disponibles del tipo indicado, se muestra alerta.&#10;• La hora de ingreso se registra automaticamente al confirmar."/>
                        </VBox>
                    </HBox>
                </content>
            </Tab>

            <!-- PESTANA 2: SALIDA Y COBRO -->
            <Tab text="Salida y cobro">
                <content>
                    <HBox spacing="20" style="-fx-padding: 16;">
                        <VBox spacing="14" styleClass="card" prefWidth="320">
                            <Label text="Registrar salida" styleClass="card-title"/>
                            <Label text="Ingrese la placa y calcule el cobro" styleClass="card-subtitle"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Placa:"/>
                                <TextField fx:id="txtPlacaSalida" prefWidth="160" promptText="Ej: ABC123"/>
                            </HBox>

                            <Button onAction="#onSimularSalida" text="Ver cobro antes de confirmar"
                                    styleClass="btn-warning" maxWidth="Infinity"/>
                            <Button onAction="#onRegistrarSalida" text="Confirmar salida y cobrar"
                                    styleClass="btn-danger" maxWidth="Infinity"/>

                            <Label wrapText="true" styleClass="card-subtitle"
                                   text="Recomendado: use 'Ver cobro' primero para informar al conductor."/>
                        </VBox>

                        <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                            <Label text="Resultado — tiempo, tarifa y total a pagar" styleClass="card-title"/>
                            <TextArea fx:id="txtSimulacionSalida" prefRowCount="14"
                                      styleClass="info-panel" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>
                </content>
            </Tab>

            <!-- PESTANA 3: BUSCAR VEHICULO -->
            <Tab text="Buscar vehiculo">
                <content>
                    <VBox spacing="14" styleClass="card" style="-fx-padding: 16;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Placa:" styleClass="card-title"/>
                            <TextField fx:id="txtPlacaBuscar" prefWidth="200" promptText="Ej: ABC123"/>
                            <Button onAction="#onBuscarVehiculo" text="Buscar" styleClass="btn-primary"/>
                        </HBox>
                        <TextArea fx:id="txtInfoVehiculo" prefRowCount="16"
                                  styleClass="info-panel" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </content>
            </Tab>

            <!-- PESTANA 4: ESPACIOS -->
            <Tab text="Espacios">
                <content>
                    <VBox spacing="16" style="-fx-padding: 16;">
                        <HBox spacing="20" alignment="CENTER">
                            <VBox styleClass="stat-box" alignment="CENTER" prefWidth="160">
                                <Label text="TOTAL" styleClass="stat-label"/>
                                <Label fx:id="lblTotalEspacios" text="0" styleClass="stat-value"/>
                            </VBox>
                            <VBox styleClass="stat-box, stat-box-ocupado" alignment="CENTER" prefWidth="160">
                                <Label text="OCUPADOS" styleClass="stat-label"/>
                                <Label fx:id="lblOcupados" text="0" styleClass="stat-value"/>
                            </VBox>
                            <VBox styleClass="stat-box, stat-box-libre" alignment="CENTER" prefWidth="160">
                                <Label text="DISPONIBLES" styleClass="stat-label"/>
                                <Label fx:id="lblDisponibles" text="0" styleClass="stat-value"/>
                            </VBox>
                            <Button onAction="#onVerEspacios" text="Actualizar" styleClass="btn-primary"/>
                        </HBox>
                        <TextArea fx:id="txtDetalleEspacios" prefRowCount="14"
                                  styleClass="info-panel" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </content>
            </Tab>

            <!-- PESTANA 5: VEHICULOS DENTRO -->
            <Tab text="Dentro del parqueadero">
                <content>
                    <VBox spacing="12" styleClass="card" style="-fx-padding: 16;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Vehiculos estacionados — placa, conductor y espacio"
                                   styleClass="card-title"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button onAction="#onActualizarLista" text="Actualizar" styleClass="btn-secondary"/>
                        </HBox>
                        <ListView fx:id="listaVehiculosDentro" prefHeight="360" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </content>
            </Tab>

            <!-- PESTANA 6: REPORTES -->
            <Tab text="Reporte del dia">
                <content>
                    <VBox spacing="14" styleClass="card" style="-fx-padding: 16;">
                        <Label text="Reporte diario del parqueadero" styleClass="card-title"/>
                        <Label wrapText="true" styleClass="card-subtitle"
                               text="Muestra total de ingresos, ingresos generados, tiempo promedio y vehiculos con mas de 5 horas."/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button onAction="#onGenerarReporte" text="Generar reporte" styleClass="btn-primary"/>
                        </HBox>
                        <TextArea fx:id="txtReporte" prefRowCount="14"
                                  styleClass="info-panel" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </content>
            </Tab>

        </TabPane>
    </center>

    <!-- ===== BARRA DE MENSAJES INFERIOR ===== -->
    <bottom>
        <Label fx:id="lblMensajeOperador" wrapText="true" styleClass="mensaje-bar" maxWidth="Infinity"/>
    </bottom>

</BorderPane>
